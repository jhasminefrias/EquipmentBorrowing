<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="using:EquipmentBorrowing.Domain"
             xmlns:conv="using:EquipmentBorrowing.Desktop.Converters"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

	<UserControl.Resources>
		<conv:BoolToAvailabilityConverter x:Key="BoolToAvail" />
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<Grid Margin="16" RowDefinitions="Auto,*" ColumnDefinitions="3*,2*">

			<TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                       Text="Equipment Directory"
                       FontSize="20" FontWeight="Bold"
                       Margin="0,0,0,12" />

			<!-- Equipment List -->
			<ListBox Grid.Row="1" Grid.Column="0"
                     Margin="0,0,12,0"
                     ItemsSource="{Binding EquipmentItems}"
                     SelectedItem="{Binding SelectedEquipment}">
				<ListBox.ItemTemplate>
					<DataTemplate DataType="domain:Equipment">
						<Grid ColumnDefinitions="120,*,100">
							<TextBlock Grid.Column="0" Text="{Binding AssetTag}" />
							<TextBlock Grid.Column="1" Text="{Binding Name}" />
							<TextBlock Grid.Column="2"
                                       Text="{Binding IsAvailable, Converter={StaticResource BoolToAvail}}"
                                       HorizontalAlignment="Right" />
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<!-- Borrow Action Panel -->
			<StackPanel Grid.Row="1" Grid.Column="1" Spacing="12">
				<TextBlock Text="Borrow Selected Equipment" FontWeight="Bold" />

				<StackPanel Spacing="4">
					<TextBlock Text="Selected Equipment:" />
					<TextBlock Text="{Binding SelectedEquipment.Name, FallbackValue='No equipment selected'}" />
					<TextBlock Text="{Binding SelectedEquipment.AssetTag, FallbackValue='Select an item from the list'}" />
				</StackPanel>

				<StackPanel Spacing="4">
					<TextBlock Text="Borrower (Student):" />
					<ComboBox ItemsSource="{Binding Students}"
                              SelectedItem="{Binding SelectedStudent}"
                              HorizontalAlignment="Stretch">
						<ComboBox.ItemTemplate>
							<DataTemplate DataType="domain:Student">
								<TextBlock Text="{Binding FullName}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<TextBlock Text="{Binding SelectedStudent.StudentNumber, StringFormat='Student ID: {0}'}" />
				</StackPanel>

				<StackPanel Spacing="4">
					<TextBlock Text="Expected Return Date:" />
					<DatePicker SelectedDate="{Binding ExpectedReturnDate}" HorizontalAlignment="Stretch" />
				</StackPanel>

				<Button Content="Borrow Equipment"
                        Command="{Binding BorrowCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />

				<TextBlock IsVisible="{Binding HasMessage}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
			</StackPanel>
		</Grid>
	</ScrollViewer>
</UserControl>