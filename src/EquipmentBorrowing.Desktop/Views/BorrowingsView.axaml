<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<Grid Margin="16" RowDefinitions="Auto,*" ColumnDefinitions="3*,2*">

			<TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                       Text="Active Borrowings"
                       FontSize="20" FontWeight="Bold"
                       Margin="0,0,0,12" />

			<!-- Active Borrowings List -->
			<ListBox Grid.Row="1" Grid.Column="0"
                     Margin="0,0,12,0"
                     ItemsSource="{Binding ActiveBorrowings}"
                     SelectedItem="{Binding SelectedBorrowing}">
				<ListBox.ItemTemplate>
					<DataTemplate DataType="vm:ActiveBorrowingItem">
						<Grid ColumnDefinitions="40,1.5*,1.5*,100">
							<TextBlock Grid.Column="0" Text="{Binding BorrowingId}" />
							<TextBlock Grid.Column="1" Text="{Binding EquipmentDisplay}" />
							<TextBlock Grid.Column="2" Text="{Binding StudentDisplay}" />
							<TextBlock Grid.Column="3" Text="{Binding ExpectedReturnDisplay}"
                                       HorizontalAlignment="Right" />
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<!-- Return Action Panel -->
			<StackPanel Grid.Row="1" Grid.Column="1" Spacing="12">
				<TextBlock Text="Return Equipment" FontWeight="Bold" />

				<StackPanel Spacing="4">
					<TextBlock Text="Selected Borrowing:" />
					<TextBlock Text="{Binding SelectedBorrowing.EquipmentDisplay, FallbackValue='No borrowing selected'}" />
					<TextBlock Text="{Binding SelectedBorrowing.StudentDisplay, FallbackValue='Select a record from the list'}" />
					<TextBlock Text="{Binding SelectedBorrowing.DateBorrowedDisplay, StringFormat='Borrowed on: {0}', FallbackValue=''}" />
				</StackPanel>

				<StackPanel Spacing="4">
					<TextBlock Text="Return Date:" />
					<DatePicker SelectedDate="{Binding ReturnDate}" HorizontalAlignment="Stretch" />
				</StackPanel>

				<Button Content="Return Equipment"
                        Command="{Binding ReturnCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />

				<TextBlock IsVisible="{Binding HasMessage}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
			</StackPanel>
		</Grid>
	</ScrollViewer>
</UserControl>