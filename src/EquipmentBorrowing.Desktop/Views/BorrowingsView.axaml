<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:conv="using:EquipmentBorrowing.Desktop.Converters"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">

    <UserControl.Resources>
        <conv:BoolToFeedbackBackgroundConverter x:Key="FeedbackBg" />
        <conv:BoolToFeedbackForegroundConverter x:Key="FeedbackFg" />
        <conv:BoolToFeedbackBorderConverter x:Key="FeedbackBorder" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16" RowDefinitions="Auto,*,Auto" ColumnDefinitions="3*,2*">
            <!-- Header -->
            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
                <TextBlock Text="Active Borrowings" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Manage borrowed equipment and process returns" Foreground="Gray" FontSize="13" />
            </StackPanel>

            <!-- Active Borrowings List -->
            <Border Grid.Row="1" Grid.Column="0"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,12,0"
                    Background="White">
                <Grid RowDefinitions="Auto,*">
                    <!-- Column Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8" ColumnDefinitions="40,1.5*,1.5*,100">
                        <TextBlock Grid.Column="0" Text="#" FontWeight="SemiBold" Foreground="#666666" />
                        <TextBlock Grid.Column="1" Text="Equipment" FontWeight="SemiBold" Foreground="#666666" />
                        <TextBlock Grid.Column="2" Text="Borrower" FontWeight="SemiBold" Foreground="#666666" />
                        <TextBlock Grid.Column="3" Text="Due Date" FontWeight="SemiBold" Foreground="#666666" HorizontalAlignment="Right" />
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ActiveBorrowings}"
                             SelectedItem="{Binding SelectedBorrowing}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:ActiveBorrowingItem">
                                <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="8,10">
                                    <Grid ColumnDefinitions="40,1.5*,1.5*,100">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding BorrowingId}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding EquipmentDisplay}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding StudentDisplay}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding ExpectedReturnDisplay}"
                                                   Foreground="#D32F2F"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Return Action Panel -->
            <Border Grid.Row="1" Grid.Column="1"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="8" Padding="16"
                    Background="White">
                <StackPanel Spacing="14">
                    <TextBlock Text="Return Equipment" FontSize="16" FontWeight="Bold" />

                    <!-- Selected Borrowing Summary -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Selected Borrowing:" FontWeight="SemiBold" FontSize="13" />
                        <Border Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding SelectedBorrowing.EquipmentDisplay, FallbackValue='No borrowing selected'}"
                                           FontWeight="Medium" />
                                <TextBlock Text="{Binding SelectedBorrowing.StudentDisplay, FallbackValue='Select a record from the list'}"
                                           Foreground="#555555" FontSize="12" />
                                <TextBlock Text="{Binding SelectedBorrowing.DateBorrowedDisplay, StringFormat='Borrowed on: {0}', FallbackValue=''}"
                                           Foreground="Gray" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Actual Return Date -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Return Date:" FontWeight="SemiBold" FontSize="13" />
                        <DatePicker SelectedDate="{Binding ReturnDate}"
                                    HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <!-- Return Button -->
                    <Button Content="Return Equipment"
                            Command="{Binding ReturnCommand}"
                            Classes="accent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="12,10"
                            Margin="0,8,0,0" />

                    <!-- Feedback message -->
                    <Border IsVisible="{Binding HasMessage}"
                            Background="{Binding IsSuccess, Converter={StaticResource FeedbackBg}}"
                            BorderBrush="{Binding IsSuccess, Converter={StaticResource FeedbackBorder}}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,8,0,0">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{Binding IsSuccess, Converter={StaticResource FeedbackFg}}"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
