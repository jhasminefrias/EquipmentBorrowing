<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Campus Equipment Borrowing System"
        Width="900" Height="600">

    <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0"
                   Text="Campus Equipment Borrowing System"
                   FontSize="20" FontWeight="Bold"
                   Margin="16,12" />

        <Grid Grid.Row="1" ColumnDefinitions="180,*">
            <!-- Navigation -->
            <StackPanel Grid.Column="0" Margin="12" Spacing="8">
                <Button Content="Equipment"
                        Command="{Binding ShowEquipmentCommand}"
                        HorizontalAlignment="Stretch" />
                <Button Content="Active Borrowings"
                        Command="{Binding ShowBorrowingsCommand}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- Current view -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentViewModel}"
                            Margin="12" />
        </Grid>
    </Grid>
</Window>