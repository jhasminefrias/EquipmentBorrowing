<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Campus Equipment Borrowing System"
        Width="1050" Height="680"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

	<Grid ColumnDefinitions="200,*">
		<!-- Sidebar Navigation -->
		<StackPanel Grid.Column="0" Margin="12" Spacing="8">
			<TextBlock Text="Navigation" FontWeight="Bold" Margin="4,0,0,8" />

			<Button Content="Equipment Directory"
                    Command="{Binding ShowEquipmentCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" />

			<Button Content="Active Borrowings"
                    Command="{Binding ShowBorrowingsCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" />
		</StackPanel>

		<!-- Dynamic Content Area -->
		<ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
	</Grid>
</Window>